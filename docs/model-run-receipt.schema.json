{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sachin7x/CATCH/blob/main/docs/model-run-receipt.schema.json",
  "title": "CATCH Model Run Receipt",
  "description": "Provenance record for a model evaluation or training run. A valid receipt records claims; it does not independently prove them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at_utc",
    "purpose",
    "repository",
    "model",
    "data",
    "execution",
    "evaluation",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "purpose": {
      "type": "string",
      "enum": ["baseline_evaluation", "safety_evaluation", "fine_tuning", "training", "inference_smoke_test"]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit_sha", "working_tree_clean"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "working_tree_clean": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "tokenizer_revision", "license_url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "tokenizer_revision": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri" },
        "base_model_revision": { "type": ["string", "null"] },
        "adapter_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_uri", "manifest_sha256", "split_method", "provenance_reviewed"],
      "properties": {
        "manifest_uri": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "split_method": { "type": "string", "minLength": 1 },
        "provenance_reviewed": { "type": "boolean" },
        "private_data_committed_to_git": { "type": "boolean", "default": false }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "runtime", "hardware", "seed", "started_at_utc", "finished_at_utc"],
      "properties": {
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "dependency_lock_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "hardware": { "type": "string", "minLength": 1 },
        "seed": { "type": ["integer", "null"] },
        "started_at_utc": { "type": "string", "format": "date-time" },
        "finished_at_utc": { "type": "string", "format": "date-time" },
        "exit_code": { "type": ["integer", "null"] }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "held_out_split", "evaluators", "metrics", "result_status"],
      "properties": {
        "protocol_id": { "type": "string", "minLength": 1 },
        "held_out_split": { "type": "string", "minLength": 1 },
        "evaluators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "revision", "role", "independent_of_training_reward"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "enum": ["primary", "independent", "human_adjudicator"] },
              "independent_of_training_reward": { "type": "boolean" },
              "rubric_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "metrics": { "type": "object" },
        "result_status": { "type": "string", "enum": ["pass", "fail", "inconclusive", "not_run"] },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "uri", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
